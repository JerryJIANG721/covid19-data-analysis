import pandas as pd 
import numpy as np 
import matplotlib.pyplot as plt
import plotly.express as px
import os
from sklearn.linear_model import LinearRegression
from prophet import Prophet as proph
import xgboost as xgb
import lightgbm as lgb
from sklearn.metrics import mean_squared_error, mean_absolute_error

BASE_DIR = os.path.dirname(__file__)

DATA_PATH = os.path.abspath(os.path.join(BASE_DIR, "..", "data", "owid-covid-data.csv"))

DATA_CLEAN_DIR = os.path.abspath(os.path.join(BASE_DIR, "..", "data_clean"))

FIGURES_DIR = os.path.abspath(os.path.join(BASE_DIR, "..", "figures"))

os.makedirs(DATA_CLEAN_DIR, exist_ok=True)
os.makedirs(FIGURES_DIR, exist_ok=True)

DATA_CLEAN_PATH = os.path.join(DATA_CLEAN_DIR, "owid-covid-data-clean.csv")

data = pd.read_csv(DATA_PATH)


data["date"] = pd.to_datetime(data["date"])
data.set_index("date", inplace=True)

data.fillna(data.select_dtypes(include='number').mean(), inplace=True)

country_map = {
        'USA': 'United States',
        'U.S.A.': 'United States',
        'US': 'United States',
        'Mainland China': 'China',
        "People's Republic of China": 'China',
        'UK': 'United Kingdom',
        'U.K.': 'United Kingdom',
        'England': 'United Kingdom',
        'South Korea': 'Korea, Republic of',
        'Republic of Korea': 'Korea, Republic of',
        'Russia': 'Russian Federation',
        'Iran (Islamic Republic of)': 'Iran',
        'Viet Nam': 'Vietnam'
    }

data["location"] = data["location"].replace(country_map) #standarize country names

data.to_csv(DATA_CLEAN_PATH) #save the clean data file

data_clean = pd.read_csv(DATA_CLEAN_PATH)

data_somme_deaths = data_clean.groupby("location")[['total_deaths']].max().reset_index()
data_somme_cases = data_clean.groupby("location")[['total_cases']].max().reset_index()

data_somme = pd.merge(data_somme_deaths, data_somme_cases, on='location', how='outer') #group by each country the total deaths and the total cases

data_new_deaths_cases_perday = data_clean.groupby("date")[['new_deaths','new_cases']].sum() #group by date for new cases and new deaths

data_new_deaths_cases_perday[["total_deaths_rate", "total_cases_rate"]] = data_clean.groupby("date")[['total_deaths_per_million','total_cases_per_million']].mean()/10000 #group by date for cases and deaths rate
data_new_deaths_cases_perday[["total_vaccinations_rate"]] = data_clean.groupby("date")[['total_vaccinations_per_hundred']].mean()/100 #group by date for cases and deaths rate

data_new_deaths_cases_perday = data_new_deaths_cases_perday.reset_index()
highest_new_cases = data_new_deaths_cases_perday['new_cases'].idxmax() #find the highest infection day

data_somme_deaths_and_cases_continents = data_clean.groupby("continent")[['total_deaths', 'total_cases']].max().reset_index()

data_new_deaths_cases_perday["date"] = pd.to_datetime(data_new_deaths_cases_perday["date"])
date = list(data_new_deaths_cases_perday['date'])

cases = list(data_new_deaths_cases_perday['new_cases'])
d_max = data_new_deaths_cases_perday.loc[highest_new_cases]['date']
i_max = int(data_new_deaths_cases_perday['new_cases'].max())

vaccination = list(data_new_deaths_cases_perday["total_vaccinations_rate"])
deaths = list(data_new_deaths_cases_perday["total_deaths_rate"])

countries = ['China', 'United States', 'United Kingdom', 'Iran', 'Africa']
somme_deaths = data_somme_deaths[data_somme_deaths['location'].isin(countries)]
somme_cases = data_somme_cases[data_somme_cases['location'].isin(countries)]
somme_deaths = somme_deaths.set_index('location').reindex(countries).reset_index()
somme_cases = somme_cases.set_index('location').reindex(countries).reset_index()
x = np.arange(len(countries))
width = 0.4

continents = list(data_somme_deaths_and_cases_continents['continent'])
somme_deaths_continents = data_somme_deaths_and_cases_continents[data_somme_deaths_and_cases_continents['continent'].isin(continents)]['total_deaths']
somme_cases_continents = data_somme_deaths_and_cases_continents[data_somme_deaths_and_cases_continents['continent'].isin(continents)]['total_cases']
xx = np.arange(len(continents))


fig, axs = plt.subplots(2,2, figsize=(15,15))

axs[0,0].plot(date, cases)
axs[0,0].scatter(d_max-pd.Timedelta(days=3), i_max, color='red', label='the highest new cases day')
axs[0,0].legend()
axs[0,0].text(d_max+pd.Timedelta(days=60), i_max, str(i_max)+' cases')
axs[0,0].set_xlabel('date')
axs[0,0].set_ylabel('new cases')
axs[0,0].set_title('Tendance of global new cases')


axs[0,1].plot(date, vaccination, color='green', label='Vaccination Rate (%)')
axs[0,1].set_xlabel('Date')
axs[0,1].set_ylabel('Rate(%)')
axs[0,1].plot(date, deaths, color='red', label='Death Rate (%)')
axs[0,1].legend()
axs[0,1].set_title('Vaccination vs Death Rate Over Time')


axs[1,0].bar(x - width/2, somme_deaths['total_deaths'], width, label='Total Deaths', color='black')
axs[1,0].bar(x + width/2, somme_cases['total_cases'], width, label='Total Cases', color='blue')
axs[1,0].set_xticks(x)
axs[1,0].set_yscale('log')
axs[1,0].set_xticklabels(countries, rotation=45, ha='right')
axs[1,0].set_ylabel('Number of People')
axs[1,0].set_title('Total COVID-19 Cases and Deaths by Country')
axs[1,0].legend()

axs[1,1].bar(xx - width/2, somme_deaths_continents, width, label='Total Deaths', color='yellow')
axs[1,1].bar(xx + width/2, somme_cases_continents, width, label='Total Cases', color='green')
axs[1,1].set_xticks(xx)
axs[1,1].set_yscale('log')
axs[1,1].set_xticklabels(continents, rotation=45, ha='right')
axs[1,1].set_ylabel('Number of people')
axs[1,1].set_title('Total COVID-19 Cases and Deaths by Continents')
axs[1,1].legend()
plt.savefig(os.path.join(FIGURES_DIR, "Plot_from_mathplotlib.jpg"), dpi=300)
plt.show()

df = pd.read_csv(DATA_CLEAN_PATH)
df["date"] = pd.to_datetime(df["date"], errors="coerce")
df = df.dropna(subset=["date"]).sort_values(["location", "date"])

df["new_cases_7d"] = df.groupby("location")["new_cases"].transform(
    lambda s: s.rolling(7, min_periods=1).mean()
)

metric_col = "new_cases_7d"
if "population" in df.columns:
    df["cases_7d_per_100k"] = df["new_cases_7d"] / (df["population"] / 100_000)
    metric_col = "cases_7d_per_100k"

use_iso = "iso_code" in df.columns
loc_col = "iso_code" if use_iso else "location"

fig = px.choropleth(
    df,
    locations=loc_col,
    color=metric_col,
    hover_name="location",
    animation_frame=df["date"].dt.strftime("%Y-%m-%d"),
    color_continuous_scale="Reds",
    title="7-day Avg New Cases per 100k (Time Slider)",
)

if not use_iso:
    fig.update_traces(locationmode="country names")

output_path = os.path.join(FIGURES_DIR, "map_cases_per_100k.html")
fig.write_html(output_path)


data_train = pd.read_csv(DATA_CLEAN_PATH)


# Linear Regression time feature
data_train["date"] = pd.to_datetime(data_train["date"])
world_cases_everyday = data_train.groupby("date")["new_cases"].sum().sort_index()

n_total = len(world_cases_everyday)
split_index = int(n_total * 0.9)

X = np.arange(n_total).reshape(-1,1)
y = world_cases_everyday.values

X_train = X[:split_index]
y_train = y[:split_index]

X_future = X[split_index:]
model_linear = LinearRegression()

model_linear.fit(X_train, y_train)
case_predict_linear = model_linear.predict(X_future)

# Prophet
data_train_proph = (
    data_train.groupby("date", as_index=False)["new_cases"]
    .sum()
    .sort_values("date")
    .rename(columns={"date": "ds", "new_cases": "y"})
)

data_train_proph["y"] = np.log1p(data_train_proph["y"])

n_total_proph = len(data_train_proph)
split_index_proph = int(n_total_proph * 0.9)

data_train_proph_train = data_train_proph.iloc[:split_index_proph]
data_train_proph_test = data_train_proph.iloc[split_index_proph:]

model_proph = proph()
model_proph.fit(data_train_proph_train)

prediction = model_proph.predict(
    model_proph.make_future_dataframe(periods=len(data_train_proph_test))
)

prophet_pred_clean = np.expm1(
    prediction["yhat"].iloc[-len(data_train_proph_test):].values
)


# Xgboost
split_index = int(len(data_train) * 0.9)
data_xgb = data_train[["continent", "location", "total_deaths", "hosp_patients","new_deaths", "total_boosters", "reproduction_rate", "total_vaccinations"]]
data_xgb_test = data_train[["continent", "location", "total_deaths", "hosp_patients","new_deaths", "total_boosters", "reproduction_rate", "total_vaccinations"]]
y_xgb = data_train["new_cases"]

X = pd.get_dummies(data_xgb, drop_first=True)
X_test = pd.get_dummies(data_xgb_test, drop_first=True)

X_train = X.iloc[:split_index]
X_eval  = X.iloc[split_index:]
y_train = y_xgb.iloc[:split_index]
y_eval  = y_xgb.iloc[split_index:]

model_xgb = xgb.XGBRegressor()
model_xgb.fit(X_train, y_train)

y_pred = model_xgb.predict(X_eval)

# LightGBM
cases_true = world_cases_everyday
n_total_cases = len(cases_true)
split_index_cases = int(n_total_cases * 0.9)
test_index = cases_true.index[split_index_cases:]


data_lgb = data_train[["continent", "location", "total_deaths", "hosp_patients","new_deaths", "total_boosters", "reproduction_rate", "total_vaccinations"]]
y_lgb = data_train["new_cases"]
X_lgb = pd.get_dummies(data_lgb, drop_first=True)
X_lgb.columns = X_lgb.columns.str.replace('[^A-Za-z0-9_]+', '_', regex=True)
split_index = int(len(data_train) * 0.9)

X_lgb_train = X_lgb.iloc[:split_index]
X_lgb_test  = X_lgb.iloc[split_index:]
y_lgb_train = y_lgb.iloc[:split_index]
y_lgb_test  = y_lgb.iloc[split_index:]

model_lgb = lgb.LGBMRegressor()
model_lgb.fit(X_lgb_train, y_lgb_train)

lgb_pred_all = model_lgb.predict(X_lgb)
lgb_pred_all = np.nan_to_num(lgb_pred_all, nan=0, posinf=0, neginf=0)

df_lgb = pd.DataFrame({"date": data_train["date"], "pred": lgb_pred_all})
lgb_daily = df_lgb.groupby("date")["pred"].sum().sort_index()
lgb_daily = lgb_daily.reindex(world_cases_everyday.index).fillna(0)

lgb_pred = lgb_daily.loc[test_index]
pred_lgb = lgb_pred.values


cases_true = world_cases_everyday
n_total = len(cases_true)
split_index_cases = int(n_total * 0.9)
test_index = cases_true.index[split_index_cases:]
true_test = cases_true.iloc[split_index_cases:]



linear_pred = case_predict_linear



prophet_full = prediction.set_index("ds")["yhat"]
prophet_pred = prophet_full.loc[test_index]
prophet_pred_clean = prediction[prediction["ds"].isin(test_index)]["yhat"].values



xgb_pred_all = model_xgb.predict(X)
df_xgb = pd.DataFrame({"date": data_train["date"], "pred": xgb_pred_all})
xgb_daily = df_xgb.groupby("date")["pred"].sum().sort_index()
xgb_pred = xgb_daily.loc[test_index]



lgb_pred_all = model_lgb.predict(X_lgb)
df_lgb = pd.DataFrame({"date": data_train["date"], "pred": lgb_pred_all})
lgb_daily = df_lgb.groupby("date")["pred"].sum().sort_index()
lgb_pred = lgb_daily.loc[test_index]



plt.figure(figsize=(14, 7))
plt.plot(test_index, true_test.values, label="True new_cases", linewidth=2, color="red")
plt.plot(test_index, linear_pred, label="Linear", linewidth=1, color="#1f77b4")
plt.plot(test_index, prophet_pred.values, label="Prophet", linewidth=1, color="#17becf")
plt.plot(test_index, xgb_pred.values, label="XGBoost", linewidth=1, color="#4b0082")
plt.plot(test_index, lgb_pred.values, label="LightGBM", linewidth=1, color="#2ca02c")
plt.xlabel("Date")
plt.ylabel("World new_cases")
plt.title("World new_cases — All Models (Test Segment)")
plt.legend()
plt.tight_layout()
plt.savefig(os.path.join(FIGURES_DIR, "Plot_of_forecasting.jpg"), dpi=300)
plt.show()



n_total_cases = len(world_cases_everyday)
split_index_cases = int(n_total_cases * 0.9)



y_true = world_cases_everyday.iloc[split_index_cases:].values
n_test = len(y_true)



pred_linear = np.array(case_predict_linear[-n_test:], dtype=float)
pred_prophet = np.array(prophet_pred_clean[-n_test:], dtype=float)
pred_xgb = np.array(xgb_pred.values[-n_test:], dtype=float)
pred_lgb = np.array(pred_lgb[-n_test:], dtype=float)



pred_linear = np.nan_to_num(pred_linear)
pred_prophet = np.nan_to_num(pred_prophet)
pred_xgb = np.nan_to_num(pred_xgb)
pred_lgb = np.nan_to_num(pred_lgb)
y_true = np.nan_to_num(y_true)



rmse_linear = np.sqrt(mean_squared_error(y_true, pred_linear))
rmse_prophet = np.sqrt(mean_squared_error(y_true, pred_prophet))
rmse_xgb = np.sqrt(mean_squared_error(y_true, pred_xgb))
rmse_lgb = np.sqrt(mean_squared_error(y_true, pred_lgb))



mae_linear = mean_absolute_error(y_true, pred_linear)
mae_prophet = mean_absolute_error(y_true, pred_prophet)
mae_xgb = mean_absolute_error(y_true, pred_xgb)
mae_lgb = mean_absolute_error(y_true, pred_lgb)



df_scores = pd.DataFrame({
    "RMSE": [rmse_linear, rmse_prophet, rmse_xgb, rmse_lgb],
    "MAE": [mae_linear, mae_prophet, mae_xgb, mae_lgb]
}, index=["Linear", "Prophet", "XGBoost", "LightGBM"])



#df_scoresy_true = np.array(y_test_daily, dtype=float)



pred_linear = np.array(case_predict_linear, dtype=float)
pred_prophet = np.array(prophet_pred_clean[-len(y_true):], dtype=float)
pred_xgb = np.array(xgb_pred.values, dtype=float)
pred_lgb = np.array(pred_lgb, dtype=float)



def align(a, b):
    m = min(len(a), len(b))
    return a[:m], b[:m]



y_lin, p_lin = align(y_true, pred_linear)
y_pro, p_pro = align(y_true, pred_prophet)
y_xgb_, p_xgb = align(y_true, pred_xgb)
y_lgb_, p_lgb = align(y_true, pred_lgb)



rmse_linear = np.sqrt(mean_squared_error(y_lin, p_lin))
rmse_prophet = np.sqrt(mean_squared_error(y_pro, p_pro))
rmse_xgb = np.sqrt(mean_squared_error(y_xgb_, p_xgb))
rmse_lgb = np.sqrt(mean_squared_error(y_lgb_, p_lgb))



mae_linear = mean_absolute_error(y_lin, p_lin)
mae_prophet = mean_absolute_error(y_pro, p_pro)
mae_xgb = mean_absolute_error(y_xgb_, p_xgb)
mae_lgb = mean_absolute_error(y_lgb_, p_lgb)



df_scores = pd.DataFrame({
    "RMSE": [rmse_linear, rmse_prophet, rmse_xgb, rmse_lgb],
    "MAE": [mae_linear, mae_prophet, mae_xgb, mae_lgb]
}, index=["Linear", "Prophet", "XGBoost", "LightGBM"])